      "prettier --write"
    ]
  },
  "dependencies": {
    "@headlessui/tailwindcss": "^0.2.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.94.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tremor/react": "^3.18.7",
    "clsx": "^2.1.1",
    "framer-motion": "^12.31.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "phosphor-react": "^1.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "tremor": "^0.0.1",
    "zod": "^4.3.6"
